{
  "name": "@antonyfaris/deno-astro-adapter",
  "description": "Deploy your Astro site to a Deno server",
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Antony Faris"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonyfaris/deno-astro-adapter.git"
  },
  "keywords": [
    "withastro",
    "astro-adapter"
  ],
  "bugs": {
    "url": "https://github.com/antonyfaris/deno-astro-adapter/issues"
  },
  "homepage": "https://github.com/antonyfaris/deno-astro-adapter/",
  "exports": {
    ".": "./src/index.ts",
    "./server.ts": "./src/server.ts",
    "./__deno_imports.ts": "./src/__deno_imports.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "deno test --allow-run --allow-env --allow-read --allow-net --allow-ffi --allow-sys ./test/",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno task check"
  },
  "dependencies": {
    "esbuild": "^0.23.0",
    "sharp": "^0.33.4"
  },
  "peerDependencies": {
    "astro": "^4.13.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "astro": "^4.13.1",
    "typescript": "^5.5.4"
  }
}
